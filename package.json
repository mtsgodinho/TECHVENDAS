{
  "name": "techvendas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:rls": "node tests/rls.mjs",
    "test": "npm run test:username && npm run test:csv && npm run test:rls && npm run test:workflows",
    "test:csv": "node --experimental-strip-types tests/csv.mjs",
    "test:workflows": "node tests/workflows.mjs",
    "test:ui": "node tests/browser.mjs",
    "test:username": "node --experimental-strip-types tests/username.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
